{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "One line of runs/<run_id>/events.ndjson. Append-only, so it carries no rev.",
  "type": "object",
  "required": [
    "seq",
    "at",
    "kind",
    "actor",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "minLength": 10
    },
    "project": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "node": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
