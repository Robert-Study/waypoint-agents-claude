{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node.schema.json",
  "title": "Node",
  "description": "projects/<id>/nodes/<node>.json: one task. Computed values such as float are never stored.",
  "type": "object",
  "required": [
    "schema",
    "project",
    "id",
    "title",
    "goal",
    "check",
    "deps",
    "estimate",
    "slot",
    "location",
    "files",
    "kind",
    "status",
    "rev",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema": {
      "const": "waypoint.node.v1"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "goal_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "check_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "check": {
      "$ref": "check.schema.json"
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "crosses"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "crosses": {
            "type": "string",
            "minLength": 1,
            "description": "What passes across this edge."
          }
        }
      }
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Parent node when this is a sub-dependency."
    },
    "estimate": {
      "type": "number",
      "minimum": 0,
      "description": "Duration units (default 1)."
    },
    "slot": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Start offset that Owner or an orchestrator may drag within the float; null = earliest."
    },
    "location": {
      "type": "object",
      "required": [
        "where",
        "changed_at"
      ],
      "additionalProperties": false,
      "description": "Where the node runs. PC and cloud can run at the same time, so this is a label, not either-or.",
      "properties": {
        "where": {
          "enum": [
            "pc",
            "cloud",
            "unset"
          ]
        },
        "changed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "description": "Optional text so the prompt packet can be shown."
    },
    "recommended": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "string"
    },
    "lane": {
      "type": [
        "string",
        "null"
      ]
    },
    "pool": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "not_started",
        "ready",
        "running",
        "submitted",
        "done",
        "error",
        "needs_you",
        "skipped",
        "carried"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Free labels set by tools, e.g. 'stale' (running with no update for 30 min; cleared on the next update)."
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision counter: +1 on every write; writers compare it before saving."
    },
    "updated_at": {
      "type": "string",
      "minLength": 10,
      "description": "ISO 8601 time of the last write."
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "description": "Who wrote it: owner, engine, a session id or an agent label."
    }
  },
  "additionalProperties": false
}
