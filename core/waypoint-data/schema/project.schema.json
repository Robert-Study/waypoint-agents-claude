{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "projects/<id>/project.json: one Waypoint plan.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "cwd",
    "created_at",
    "archived",
    "status",
    "family",
    "version",
    "rev",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema": {
      "const": "waypoint.project.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string"
    },
    "goal_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "cwd": {
      "type": "object",
      "description": "Working folder as a machine name plus a path relative to that machine's code root. Never an absolute drive path.",
      "required": [
        "machine",
        "rel"
      ],
      "additionalProperties": false,
      "properties": {
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "rel": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*\\.\\.).*$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "archived": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Family id this project is a version of, or null."
    },
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Ordinal of this project in its family (1, 2, ...): order only, never shown when a version_label is set."
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 32,
      "description": "The product's own version name (for example V10 or 1.2), shown instead of the ordinal; optional."
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision counter: +1 on every write; writers compare it before saving."
    },
    "updated_at": {
      "type": "string",
      "minLength": 10,
      "description": "ISO 8601 time of the last write."
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "description": "Who wrote it: owner, engine, a session id or an agent label."
    }
  },
  "additionalProperties": false
}
